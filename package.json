{
  "name": "backlog-defense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BACKLOG DEFENSE 3000 – Tower Defense im Agile-Büro (Phaser 4)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "replay": "tsx tools/replay-cli.ts",
    "bench": "tsx tools/bench.ts",
    "assets": "tsx tools/build-assets.ts",
    "check:assets": "tsx tools/check-assets.ts",
    "balance": "tsx tools/balance.ts",
    "db:push": "tsx tools/db-push.ts",
    "fn:deploy": "tsx tools/fn-deploy.ts",
    "build:sim": "tsx tools/build-sim.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "free-tex-packer-core": "^0.3.9",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
